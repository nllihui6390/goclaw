# 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== 供应商配置 =====
# 供应商 API Key 和 Base URL 可通过环境变量覆盖 config.json
# 格式: PROVIDER_<供应商名>_API_KEY / PROVIDER_<供应商名>_BASE_URL
# 供应商名需大写，对应 config.json 中 providers 的 key

# DeepSeek / 天翼云等 OpenAI兼容API
PROVIDER_DEEPSEEK_API_KEY=your-deepseek-api-key
PROVIDER_DEEPSEEK_BASE_URL=https://eaichat.ctyun.cn/ai/platform/v2/cp

# Ollama 本地模型（默认无需认证，如需自定义地址）
PROVIDER_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI
PROVIDER_OPENAI_API_KEY=your-openai-api-key
PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 其他配置 =====
# 和风天气API Key（可选，天气工具需要）
HEFENG_API_KEY=your-hefeng-api-key

# 配置热加载（可选）
GOCLAW_HOT_RELOAD=true