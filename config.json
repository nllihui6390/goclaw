{
  "gateway": {
    "default_agent": "default",
    "session_ttl": 0,
    "data_dir": "clawdata",
    "workspace": "workspaces",
    "default_provider": "deepseek",
    "default_model": "deepseek-v4-oc"
  },
  "providers": {
    "deepseek": {
      "type": "openai",
      "base_url": "https://eaichat.ctyun.cn/ai/platform/v2/cp",
      "api_key": "",
      "models": [
        {
          "name": "deepseek-v4-oc",
          "description": "DeepSeek-V4"
        }
      ]
    },
    "ollama": {
      "type": "ollama",
      "base_url": "http://localhost:11434",
      "models": [
        {
          "name": "llama3",
          "description": "Llama 3 默认模型"
        },
        {
          "name": "qwen2.5:7b",
          "description": "Qwen 2.5 7B"
        },
        {
          "name": "glm4:9b",
          "description": "GLM-4 9B",
          "supports_image": true
        }
      ]
    }
  },
  "agents": [
    {
      "name": "default",
      "provider": "deepseek",
      "system_prompt": "你是一个智能AI助手，可以使用工具帮助用户完成任务。",
      "tools": [
        "weather",
        "exec",
        "write_file",
        "read_file",
        "edit_file",
        "append_file",
        "send_file",
        "browser_use",
        "set_user_timezone"
      ],
      "max_iterations": 20
    },
    {
      "name": "local",
      "provider": "ollama",
      "model": "qwen2.5:7b",
      "system_prompt": "你是一个本地AI助手，运行在Ollama上。",
      "tools": [
        "weather",
        "exec",
        "write_file",
        "read_file",
        "edit_file",
        "append_file",
        "send_file",
        "browser_use",
        "set_user_timezone"
      ],
      "max_iterations": 20
    }
  ],
