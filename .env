# 和风天气 API Key
# 注册地址: https://dev.qweather.com/
HEFENG_API_KEY=your_hefeng_api_key_here

# OpenWeatherMap API Key  
# 注册地址: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# 心知天气 API Key
# 注册地址: https://www.seniverse.com/
SENIVERSE_API_KEY=your_seniverse_key_here

# 选择使用的天气API类型: hefeng, openweather, seniverse
WEATHER_API_TYPE=hefeng

# OpenAI API Key
OPENAI_API_KEY=""

# OpenAI Base URL (可选，用于代理或本地模型)
OPENAI_BASE_URL=""